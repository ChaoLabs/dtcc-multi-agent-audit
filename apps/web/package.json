{
  "name": "@dtcc-audit/web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.14.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "format:check": "prettier --check src tests *.ts *.mjs *.json",
    "test:e2e": "playwright test",
    "generate:types": "json2ts -i src/generated/report.schema.json -o src/generated/report.d.ts --bannerComment '' && json2ts -i src/generated/review.schema.json -o src/generated/review.d.ts --bannerComment '' && prettier --write src/generated"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "ajv": "8.20.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "json-schema-to-typescript": "^15.0.4",
    "prettier": "^3.6.0",
    "typescript": "5.9.3"
  }
}
